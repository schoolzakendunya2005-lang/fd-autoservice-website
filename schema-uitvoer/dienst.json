    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wat kost een APK bij FD Autoservice?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "€60, inclusief de afmelding bij de RDW. Dat is een vaste prijs, ongeacht je automerk of model. Er komen geen bijkomende kosten bij voor de keuring zelf."
          }
        },
        {
          "@type": "Question",
          "name": "Hoe lang duurt een APK?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "De keuring zelf duurt ongeveer drie kwartier. Breng je de auto 's ochtends vóór 12:00 langs, dan is hij vrijwel altijd dezelfde dag klaar."
          }
        },
        {
          "@type": "Question",
          "name": "Kan ik mijn APK eerder laten doen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja, tot twee maanden voor de vervaldatum. Je raakt die maanden niet kwijt: de nieuwe APK gaat in op je oude vervaldatum."
          }
        },
        {
          "@type": "Question",
          "name": "Wat gebeurt er als mijn auto wordt afgekeurd?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We bellen je eerst en leggen uit wat er is afgekeurd en wat herstel kost. Zonder jouw akkoord voeren we niets uit."
          }
        },
        {
          "@type": "Question",
          "name": "Doen jullie ook APK op zaterdag?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nee. Op zaterdag zijn we open voor onderhoud, banden en reparaties, maar de keurmeester is er alleen doordeweeks. APK plan je dus van maandag tot en met vrijdag."
          }
        }
      ]
