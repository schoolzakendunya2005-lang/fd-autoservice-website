    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wat kost een APK bij FD Autoservice?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "€ 60, een vaste prijs, ongeacht je automerk of model. Geen verrassingen achteraf. Wordt je auto afgekeurd, dan bespreken we eerst wat er moet gebeuren en wat dat kost; je bent niet verplicht die reparatie bij ons te laten doen."
          }
        },
        {
          "@type": "Question",
          "name": "Hoe snel kan ik bij jullie terecht?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Voor APK, banden en kleinere reparaties vaak nog deze week. Voor spoed bellen we liever even, soms kan het dezelfde dag nog."
          }
        },
        {
          "@type": "Question",
          "name": "Werken jullie aan alle automerken?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja. Volkswagen, Audi, BMW, Toyota, Renault, Peugeot, Ford, Mercedes. Wij doen er alles aan dat met vier wielen rijdt."
          }
        },
        {
          "@type": "Question",
          "name": "Behoud ik fabrieksgarantie als ik bij jullie onderhoud laat doen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja. We werken volgens fabrieksvoorschrift en gebruiken de juiste onderdelen, je fabrieksgarantie blijft gewoon geldig."
          }
        },
        {
          "@type": "Question",
          "name": "Krijg ik altijd vooraf de prijs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Altijd. We bellen je vóór we iets vervangen dat boven het afgesproken bedrag uitkomt. Geen akkoord = geen werk."
          }
        },
        {
          "@type": "Question",
          "name": "Do you also help expats / English speakers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we explain everything in English if you prefer. WhatsApp us your question and we'll reply in English."
          }
        },
        {
          "@type": "Question",
          "name": "Wat kost het vervangen van een band?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "€ 30 ex BTW per band, ongeacht de maat. Dat is het montageloon. De banden zelf komen daarbij. Hoeveel banden je wil laten doen geef je door bij aankomst; we rekenen achteraf af op basis van wat er daadwerkelijk gedaan is."
          }
        },
        {
          "@type": "Question",
          "name": "Moet ik mijn auto de hele dag afgeven?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Breng je auto 's ochtends vóór 12:00 uur langs, dan is hij meestal dezelfde dag klaar. Lukt dat een keer niet, bijvoorbeeld omdat een onderdeel besteld moet worden, dan hoor je dat dezelfde dag van ons, niet pas als je voor de deur staat."
          }
        }
      ]
